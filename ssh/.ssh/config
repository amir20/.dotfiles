Include ~/.orbstack/ssh/config

Host *
  IdentityAgent "~/.1password/agent.sock"
  SetEnv TERM=xterm-256color

# tmux only for an interactive login: a session that sends a command
# (docker --context, scp, `ssh host cmd`) can't also run a RemoteCommand
Match host b.dozzle.dev sessiontype shell
  RequestTTY yes
  RemoteCommand tmux new -A -s ssh-tmuxHost

Match host cloud.dozzle.dev sessiontype shell
  RequestTTY yes
  RemoteCommand tmux new-session -A -s main
