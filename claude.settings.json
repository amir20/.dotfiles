{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/ci-status:~/.claude/mods/long-command"
  }
}
